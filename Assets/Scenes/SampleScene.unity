  leftPageTextUI: {fileID: 1733598159}
  rightPageTextUI: {fileID: 392203904}
  leftPageContent: "\u041A\u0430\u0436\u0443\u0442\u044C, \u0443\u0432\u0456 \u0441\u043D\u0456
    \u043C\u0438 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0431\u0430\u0447\u0438\u043C\u043E
    \u043E\u0431\u043B\u0438\u0447 \u2014 \u043B\u0438\u0448\u0435 \u0440\u043E\u0437\u043C\u0438\u0442\u0456
    \u0442\u0456\u043D\u0456 \u0442\u0438\u0445, \u043A\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0441\u044C
    \u0437\u043D\u0430\u043B\u0438. \u0410\u043B\u0435 \u0432 \u0446\u044C\u043E\u043C\u0443
    \u043C\u0456\u0441\u0446\u0456 \u0432\u0441\u0435 \u0456\u043D\u0430\u043A\u0448\u0435.
    \u041A\u043E\u0436\u043D\u0430 \u0442\u0440\u0456\u0449\u0438\u043D\u0430 \u043D\u0430
    \u0441\u0442\u0435\u043B\u0456, \u043A\u043E\u0436\u0435\u043D \u0441\u043A\u0440\u0438\u043F
    \u043C\u043E\u0441\u0442\u0438\u043D\u0438 \u0437\u0434\u0430\u044E\u0442\u044C\u0441\u044F
    \u0431\u043E\u043B\u0456\u0441\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C\u0438.
    \u0422\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0448 \u0445\u043E\u043B\u043E\u0434,
    \u0430\u043B\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448 \u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u0438\u0441\u044C.
    \u0427\u043E\u043C\u0443 \u0446\u044F \u043A\u0456\u043C\u043D\u0430\u0442\u0430
    \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0442\u0430\u043A\u043E\u044E
    \u0437\u043D\u0430\u0439\u043E\u043C\u043E\u044E, \u0445\u043E\u0447\u0430 \u0442\u0438
    \u0431\u0430\u0447\u0438\u0448 \u0457\u0457 \u0432\u043F\u0435\u0440\u0448\u0435?"
  rightPageContent: "\u0421\u043E\u043D \u2014 \u0446\u0435 \u0454\u0434\u0438\u043D\u0435
    \u043C\u0456\u0441\u0446\u0435, \u0434\u0435 \u043C\u0438 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0456
    \u0443 \u0432\u043B\u0430\u0441\u043D\u043E\u043C\u0443 \u0440\u043E\u0437\u0443\u043C\u0456
    \u0431\u0435\u0437 \u043A\u043B\u044E\u0447\u0430. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
    \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u0436\u0430\u0445 \u043D\u0435
    \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E \u0442\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448
    \u0432\u0438\u0439\u0442\u0438, \u0430 \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E
    \u0442\u0438 \u0442\u0443\u0442 \u043D\u0435 \u043E\u0434\u0438\u043D. \u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435:
    \u044F\u043A\u0449\u043E \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435 \u043E\u0431\u043B\u0438\u0447\u0447\u044F
    \u0432 \u0442\u0456\u043D\u0456 \u2014 \u0432\u0438 \u0432\u0436\u0435 \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043F\u0438\u0442\u0435. \u0412\u0438
    \u0441\u0442\u0430\u043B\u0438 \u0447\u0430\u0441\u0442\u0438\u043D\u043E\u044E
    \u0447\u0438\u0454\u0457\u0441\u044C \u0456\u043D\u0448\u043E\u0457 \u043C\u0440\u0456\u0457."
  appearanceSpeed: 0.443
  lampLight: {fileID: 0}
  switchSound: {fileID: 0}
